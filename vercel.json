    },
    {
      "path": "/api/cron/search-console-sync",
      "schedule": "15 1 * * 1"
    },
    {
      "path": "/api/cron/search-console-audit?scope=sitemap&limit=8",
      "schedule": "30 1 * * 1"
    },
    {
      "path": "/api/cron/search-console-health",
      "schedule": "45 1 * * 1"
    },
    {
      "path": "/api/cron/website-monitor",
      "schedule": "7 */6 * * *"
    }
